{
  "name": "craigslist-alert-triage",
  "version": "0.1.0",
  "private": true,
  "description": "Evaluate Craigslist Gmail alerts against personal housing preferences and notify via Telegram.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "npm run build && clasp push",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "@types/google-apps-script": "^2.0.8",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
